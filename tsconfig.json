{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "noUncheckedSideEffectImports": false,
    "libReplacement": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["src", "obsidian/src", "obsidian/vite.config.ts", "vite.config.ts"]
}
