/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; style-src 'self'; connect-src 'self' wss: https://ntfy.sh; img-src 'self' data: blob:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# The probe page also fetches api.github.com; a second rule adds its own CSP only here.
/probe*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self'; connect-src 'self' wss: https://api.github.com https://ntfy.sh; img-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# Offline support (docs/offline.md): the worker script and the pages must be revalidated on every
# load so a new deploy is seen at once. Hashed files under /assets/ keep the host's default.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/probe
  Cache-Control: no-cache
/probe.html
  Cache-Control: no-cache

# Installable app (docs/decisions/offline.md): revalidated like the pages; the host types .webmanifest itself.
/manifest.webmanifest
  Cache-Control: no-cache
